# Copy to .env and fill in. Never commit .env.

# ENTSO-E Transparency Platform "Web API Security Token".
# Register at https://transparency.entsoe.eu/, then email transparency@entsoe.eu
# with subject "Restful API access" and your registered address in the body.
# Access is granted in ~3 working days; the token then appears in your account
# settings under "Web API Security Token".
ENTSOE_API_KEY=
