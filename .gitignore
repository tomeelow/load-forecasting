# Data and model artifacts — tracked by DVC / MLflow, never by git
data/
*.parquet
*.csv
*.pkl
*.joblib
*.txt.model
*.lgb
*.onnx

# MLflow
mlruns/
mlartifacts/
mlflow.db

# Monitoring and evaluation output
monitoring/reports/
# Evaluation output: the generated benchmark tables are deliverables and are
# versioned; the prediction dumps behind them are not.
reports/*
!reports/*.md

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Pipeline state (prediction log, run markers) — see ADR-008
state/
