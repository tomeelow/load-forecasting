# Data and model artifacts — MLflow holds the models, the dataset is content-hashed
# per run and re-pullable from the source APIs (ADR-003). Never git.
data/
*.parquet
*.csv
*.pkl
*.joblib
*.txt.model
*.lgb
*.onnx

# MLflow
mlruns/
mlartifacts/
mlflow.db

# Monitoring and evaluation output. `monitoring.reports_dir` writes the drift HTML
# straight into monitoring/, and one Evidently report is four megabytes — they are
# generated per run and uploaded as workflow artifacts, never committed.
monitoring/*.html
# Evaluation output: the generated benchmark tables are deliverables and are
# versioned; the raw prediction dumps behind them are not — with one exception. The
# dashboard plots the gate-closure backtest, and a host that builds from this repository
# can only show what the repository carries, so that one is committed gzipped (660KB ->
# 199KB). Regenerate it with `pipelines.audit`, then re-gzip; see deploy/streamlit-cloud.md.
reports/*
!reports/*.md
!reports/*.csv.gz

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Pipeline state (prediction log, run markers) — see ADR-008
state/

# Editor/agent scratch
.claude/
